# Embedded toolchain dirs warmup.bat builds on Windows hosts. They
# only exist in a checkout that has run warmup.bat, never in a fresh
# clone. Listed here so `rsync --filter=':- .gitignore' --delete`
# preserves them; a missing entry here means `--delete` wipes them and
# recovery requires re-running warmup.bat (20-30 min, ~10GB of
# downloads).
build-win-native/cuda
build-win-native/dist
build-win-native/mingit
build-win-native/7zip
build-win-native/msvc
build-win-native/jupyter
build-win-native/fast_check
build-win-native/python_full
# build-mac-native/, the same split as the Windows block above: the scripts,
# scripts/downloads.txt and README.md are tracked, and everything warmup.sh
# provisions or build.sh and bundle.sh generate is not. Once warmup.sh has
# run this directory holds a toolchain that only exists on the macOS host,
# so these entries are also what keeps `rsync --filter=':- .gitignore'
# --delete` from wiping it.
build-mac-native/.*
build-mac-native/downloads
build-mac-native/rust
build-mac-native/deps
build-mac-native/python
build-mac-native/dist
build-mac-native/jupyter
build-mac-native/ffmpeg
build-mac-native/temp_ffmpeg
build-mac-native/start.sh
build-mac-native/*.log
build-mac-native/*.pem
build-mac-native/*.zip
build-mac-native/*.tar.gz
build-mac-native/*.dmg
build-mac-native/*.pkg
# build-linux-native/, the same split as the macOS block above: the scripts,
# scripts/downloads.txt and README.md are tracked, and everything warmup.sh
# provisions or build.sh and bundle.sh generate is not. Once warmup.sh has run
# this directory holds a CUDA toolkit, an interpreter and a Rust toolchain, so
# these entries are also what keeps `rsync --filter=':- .gitignore' --delete`
# from wiping them.
build-linux-native/.*
build-linux-native/downloads
build-linux-native/rust
build-linux-native/cuda
build-linux-native/rocm
build-linux-native/python
build-linux-native/patchelf
build-linux-native/nasm
build-linux-native/ffmpeg
build-linux-native/dist
build-linux-native/jupyter
build-linux-native/start.sh
build-linux-native/*.log
build-linux-native/*.tar.gz
.claude/
.venv/

